# This file was modified in 2026 by YiQiao contributors. See NOTICE.
# English source: .env.example

# 模型服务商凭据。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 默认拉取已发布镜像。使用私有镜像仓库时可覆盖镜像地址；也可以通过
# docker-compose.build.yaml 从当前检出的源码构建。
YIQIAO_API_IMAGE=ghcr.io/daizhongming/yiqiao-api:latest
YIQIAO_DASHBOARD_IMAGE=ghcr.io/daizhongming/yiqiao-dashboard:latest
YIQIAO_PULL_POLICY=always

# 主机服务端点。数据库服务仅保留在 Docker 内部网络中。
API_BIND_ADDRESS=127.0.0.1
API_PORT=8888
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
# 当用户通过代理或非本地主机名访问 YiQiao 时设置以下地址。
PUBLIC_API_URL=
PUBLIC_DASHBOARD_URL=

# 源码构建使用的软件包镜像。默认值指向各软件包的官方仓库。
DEBIAN_MIRROR=https://deb.debian.org
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# 使用下方 YIQIAO_* 变量配置模型服务商。
# LLM 配置。
LLM_API_KEY=
YIQIAO_LLM_PROVIDER=openai
YIQIAO_LLM_BASE_URL=
YIQIAO_LLM_MODEL=gpt-4.1-nano-2025-04-14
YIQIAO_LLM_MAX_TOKENS=4096
YIQIAO_LLM_TIMEOUT_SECONDS=30
YIQIAO_LLM_MAX_RETRIES=0

# 可恢复的聊天记忆导入。每个分块目标为 4k-6k tokens；同一会话保持顺序，
# 不同会话使用有上限的自适应并发。
MEMORY_IMPORT_WORKERS=3
MEMORY_IMPORT_MAX_WORKERS=4
MEMORY_IMPORT_TARGET_TOKENS=5000
MEMORY_IMPORT_MAX_TOKENS=6000
MEMORY_IMPORT_OVERLAP_TURNS=1
MEMORY_IMPORT_MODEL_TIERING_ENABLED=false
MEMORY_IMPORT_FAST_MODEL=gemini-2.5-flash
MEMORY_IMPORT_FALLBACK_MODEL=gemini-2.5-pro
# 可选的分层导入模型独立路由。三个值必须同时配置；密钥本身保存在所指定的环境变量中。
MEMORY_IMPORT_LLM_PROVIDER=
MEMORY_IMPORT_LLM_BASE_URL=
MEMORY_IMPORT_LLM_API_KEY_ENV=
MEMORY_IMPORT_AUDIT_RATIO=0.07
MEMORY_IMPORT_MIN_CONFIDENCE=0.65
MEMORY_IMPORT_LLM_MAX_OUTPUT_TOKENS=8192
MEMORY_IMPORT_LLM_TIMEOUT_SECONDS=120
MEMORY_IMPORT_LEASE_SECONDS=120
MEMORY_IMPORT_LEASE_RENEW_SECONDS=40
MEMORY_IMPORT_RECOVERY_SCAN_SECONDS=15
MEMORY_IMPORT_STORAGE_ROOT=/app/history/memory-imports
MEMORY_IMPORT_MAX_ACTIVE_JOBS_PER_PROJECT=2
MEMORY_IMPORT_MAX_RETAINED_WORKSPACE_BYTES=2147483648

# 记忆写入未显式指定 infer 时使用的默认值。
YIQIAO_DEFAULT_INFER=true

# 嵌入模型配置。
EMBEDDING_API_KEY=
YIQIAO_EMBEDDER_PROVIDER=openai
YIQIAO_EMBEDDER_BASE_URL=
YIQIAO_EMBEDDER_MODEL=text-embedding-3-small
YIQIAO_EMBEDDER_DIMS=1024
# 仅用于 LiteLLM：允许指定的嵌入参数通过其 OpenAI 兼容适配器。
YIQIAO_EMBEDDER_ALLOWED_OPENAI_PARAMS=

# 可选的重排序器。设置 YIQIAO_RERANK_MODEL 后，检索传入 rerank=true 即可启用重排序。
RERANK_API_KEY=
YIQIAO_RERANK_PROVIDER=
YIQIAO_RERANK_LLM_PROVIDER=openai
YIQIAO_RERANK_BASE_URL=
YIQIAO_RERANK_MODEL=
YIQIAO_RERANK_TOP_K=5
YIQIAO_RERANK_TEMPERATURE=0
YIQIAO_RERANK_MAX_TOKENS=20

# PostgreSQL。密码由 scripts/init.sh 或 scripts/init.ps1 生成。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# 仅限本地开发。生产环境必须保持 false。
AUTH_DISABLED=false
DASHBOARD_URLS=
# 全新 Compose 数据卷只初始化 yiqiao_app。仅当目标 PostgreSQL 中已创建其他数据库时，
# 才能使用不同名称。
APP_DB_NAME=yiqiao_app

# Neo4j 图数据库。
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# 可选匿名遥测。默认关闭；启用时必须提供自己的 PostHog 密钥。
YIQIAO_TELEMETRY=false
YIQIAO_POSTHOG_API_KEY=
YIQIAO_POSTHOG_HOST=https://us.i.posthog.com

# 执行 `make prune-logs` 时保留 request_logs 历史记录的天数。
# 生产环境应通过 cron/systemd 定期运行清理命令。
REQUEST_LOG_RETENTION_DAYS=30
