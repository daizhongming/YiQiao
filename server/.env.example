# This file was modified in 2026 by YiQiao contributors. See NOTICE.

# Provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Published images are pulled by default. Set custom image references for a
# private mirror, or use docker-compose.build.yaml to build from this checkout.
YIQIAO_API_IMAGE=ghcr.io/daizhongming/yiqiao-api:latest
YIQIAO_DASHBOARD_IMAGE=ghcr.io/daizhongming/yiqiao-dashboard:latest
YIQIAO_PULL_POLICY=always

# Host endpoints. Database services stay on the internal Docker network.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8888
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
# Set these when users reach YiQiao through a proxy or non-local hostname.
PUBLIC_API_URL=
PUBLIC_DASHBOARD_URL=

# Source-build package mirrors. The defaults use the upstream repositories.
DEBIAN_MIRROR=https://deb.debian.org
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# New deployments use YIQIAO_* provider settings. Corresponding MEM0_* names
# remain supported as legacy fallbacks; configure only one naming family.
# LLM configuration.
LLM_API_KEY=
YIQIAO_LLM_PROVIDER=openai
YIQIAO_LLM_BASE_URL=
YIQIAO_LLM_MODEL=gpt-4.1-nano-2025-04-14
YIQIAO_LLM_MAX_TOKENS=4096
YIQIAO_LLM_TIMEOUT_SECONDS=30
YIQIAO_LLM_MAX_RETRIES=0

# Resumable chat-memory imports. Chunks target 4k-6k tokens and conversations
# remain ordered while separate conversations use bounded adaptive concurrency.
MEMORY_IMPORT_WORKERS=3
MEMORY_IMPORT_MAX_WORKERS=4
MEMORY_IMPORT_TARGET_TOKENS=5000
MEMORY_IMPORT_MAX_TOKENS=6000
MEMORY_IMPORT_OVERLAP_TURNS=1
MEMORY_IMPORT_MODEL_TIERING_ENABLED=false
MEMORY_IMPORT_FAST_MODEL=gemini-2.5-flash
MEMORY_IMPORT_FALLBACK_MODEL=gemini-2.5-pro
# Optional isolated route for tiered import models. Configure all three values
# together; the key itself stays in the named environment variable.
MEMORY_IMPORT_LLM_PROVIDER=
MEMORY_IMPORT_LLM_BASE_URL=
MEMORY_IMPORT_LLM_API_KEY_ENV=
MEMORY_IMPORT_AUDIT_RATIO=0.07
MEMORY_IMPORT_MIN_CONFIDENCE=0.65
MEMORY_IMPORT_LLM_MAX_OUTPUT_TOKENS=8192
MEMORY_IMPORT_LLM_TIMEOUT_SECONDS=120
MEMORY_IMPORT_LEASE_SECONDS=120
MEMORY_IMPORT_LEASE_RENEW_SECONDS=40
MEMORY_IMPORT_RECOVERY_SCAN_SECONDS=15
MEMORY_IMPORT_STORAGE_ROOT=/app/history/memory-imports
MEMORY_IMPORT_MAX_ACTIVE_JOBS_PER_PROJECT=2
MEMORY_IMPORT_MAX_RETAINED_WORKSPACE_BYTES=2147483648

# Used when a memory write does not include an explicit infer value.
YIQIAO_DEFAULT_INFER=true

# Embedding configuration.
EMBEDDING_API_KEY=
YIQIAO_EMBEDDER_PROVIDER=openai
YIQIAO_EMBEDDER_BASE_URL=
YIQIAO_EMBEDDER_MODEL=text-embedding-3-small
YIQIAO_EMBEDDER_DIMS=1024
# LiteLLM only: allow configured embedding parameters through its OpenAI-compatible adapter.
YIQIAO_EMBEDDER_ALLOWED_OPENAI_PARAMS=

# Optional reranker. Setting YIQIAO_RERANK_MODEL enables reranking when search passes rerank=true.
RERANK_API_KEY=
YIQIAO_RERANK_PROVIDER=
YIQIAO_RERANK_LLM_PROVIDER=openai
YIQIAO_RERANK_BASE_URL=
YIQIAO_RERANK_MODEL=
YIQIAO_RERANK_TOP_K=5
YIQIAO_RERANK_TEMPERATURE=0
YIQIAO_RERANK_MAX_TOKENS=20

# Postgres. scripts/init.sh and scripts/init.ps1 generate the password.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URLS=
# Fresh Compose volumes initialize only yiqiao_app. Use another name only when
# that database has already been created on the target PostgreSQL server.
APP_DB_NAME=yiqiao_app

# Neo4j graph database.
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional anonymous telemetry. Disabled unless you provide your own PostHog key.
YIQIAO_TELEMETRY=false
# MEM0_TELEMETRY remains a legacy fallback; leave it unset for new deployments.
YIQIAO_POSTHOG_API_KEY=
YIQIAO_POSTHOG_HOST=https://us.i.posthog.com

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
